# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# TARGET CHANNEL / GROUP
# Gunakan @username channel atau chat_id numerik
# Contoh: @mychannel atau -1001234567890
# ============================================
TELEGRAM_CHAT_ID=your_channel_or_group_id_here

# ============================================
# JADWAL PENGIRIMAN (format: HH:MM, WIB/UTC+7)
# ============================================
SCHEDULE_GEOPOLITIK=07:00
SCHEDULE_FINANCIAL=08:00
SCHEDULE_BOLA=09:00
SCHEDULE_RINGKASAN_MALAM=21:00

# ============================================
# NEWSAPI (Opsional - untuk berita tambahan)
# Daftar gratis di https://newsapi.org
# ============================================
NEWSAPI_KEY=your_newsapi_key_here

# ============================================
# TIMEZONE
# ============================================
TIMEZONE=Asia/Jakarta
